+        "loom",
+        "meta-only",
+        "meta-side",
+        "other",
+        "tag-side",
+    ]
+    # The epic column stays OPEN epics only — a finished initiative is not a
+    # scope anyone picks next.
+    assert re.findall(r'data-picker-epic="([^"]+)"', html) == ["epic"]
+    assert "data-graph-layers" not in html
