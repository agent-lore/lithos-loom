+def test_a_cross_scope_cycle_is_listed_as_external_and_draws_no_group(
+    lithos_lens_config_env: Path,
+) -> None:
+    """A -> ghost -> ghost -> A is invisible to SCC, and still never dropped."""
+    tasks = [
