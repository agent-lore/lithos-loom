+
+
+def test_lithos_flag_on_an_scc_member_keeps_the_drawable_shape() -> None:
+    tasks = _tasks("A", "B")
+    topology = build_topology(
+        tasks, _edges("A>B", "B>A"), blocked=[_cycle_flag(tasks[1])]
+    )
