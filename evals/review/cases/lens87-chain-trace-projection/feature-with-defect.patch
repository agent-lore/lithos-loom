+    box = styles["cycle::cycle-a"]
+    ordinary = styles["ship"]
+
+    assert box["borderStyle"] == "dashed"
+    assert box["borderStyle"] != ordinary["borderStyle"]
+    assert box["borderWidth"] > ordinary["borderWidth"]
