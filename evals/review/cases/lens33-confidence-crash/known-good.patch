+/* Metadata chips + lede (§6.4). Neutral chips by default; the status chip is
+   colour-coded so a quarantined note reads as quarantined at a glance. */
+.note-chips {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.4rem;
+}
+
+.chip {
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  display: inline-flex;
+  font-size: 0.78rem;
+  gap: 0.3rem;
+  line-height: 1;
+  padding: 0.35rem 0.55rem;
+}
+
+.note-status-active {
+  border-color: rgba(53, 106, 77, 0.35);
+  color: var(--ok);
+}
+
+.note-status-archived {
+  border-color: rgba(65, 87, 111, 0.35);
+  color: var(--closed);
+}
+
+.note-status-quarantined {
+  background: rgba(189, 79, 43, 0.12);
+  border-color: rgba(189, 79, 43, 0.5);
+  color: var(--cancelled);
+  font-weight: 700;
+}
+
+.note-lede {
+  color: var(--muted);
+  font-size: 1.05rem;
+  font-style: italic;
+  margin: 0;
+}
+
+.note-authorship {
+  color: var(--muted);
+  font-size: 0.85rem;
+}
+
 .claim-list {
   grid-column: 1 / -1;
 }
