+    cursor: str | None = None
+    seen: set[str] = set()
+    for _ in range(TOOL_LIST_MAX_PAGES):
+        result = await session.list_tools(cursor=cursor)
+        names.update(
+            str(getattr(tool, "name", "") or "")
+            for tool in getattr(result, "tools", [])
+        )
+        cursor = getattr(result, "nextCursor", None)
+        if not cursor:
+            names.discard("")
+            return names
+        if cursor in seen:
+            break
+        seen.add(cursor)
