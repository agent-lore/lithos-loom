+def test_load_dashboard_resolves_ready_blocked_overlap_conservatively() -> None:
+    """A task returned by BOTH frontiers means the independent reads disagree.
+    It must render Blocked (keeping its blocker evidence) and say so, not be
+    silently presented as workable-now by branch order."""
+    contested = _task("c", claims=())
+    fake = _FrontierFake(
+        open_tasks=[contested],
