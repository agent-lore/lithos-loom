+    truncation — the operator must not be shown a false accuracy warning."""
+    ready = _task("r", claims=())
+    skewed = _task("o", claims=())
+    fake = _FrontierFake(open_tasks=[ready, skewed], ready=[ready], blocked=[])
+    data = asyncio.run(load_dashboard(fake, filters=_FILTERS, frontier_limit=500))
+    assert _section_ids(data.sections, "unclassified") == ["o"]
+    assert data.truncated is False
